# Nginx: /etc/nginx/sites-available/analyzer.silakes.labkesdasumenep.id (tautkan ke sites-enabled).
# Blok HTTPS ditambahkan certbot: sudo certbot --nginx -d analyzer.silakes.labkesdasumenep.id
server {
    server_name analyzer.silakes.labkesdasumenep.id;

    access_log /var/log/nginx/analyzer.silakes.access.log;
    error_log /var/log/nginx/analyzer.silakes.error.log;

    client_max_body_size 5M;

    location / {
        proxy_pass http://127.0.0.1:5065;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # sinkronisasi dan deteksi dapat berjalan lebih dari satu menit
        proxy_read_timeout 620s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 620s;
    }

    listen 80;
    listen [::]:80;
}
